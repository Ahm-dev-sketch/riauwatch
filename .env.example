# RIAUWATCH Environment Variables
# NEVER COMMIT REAL .env FILES — THIS IS A TEMPLATE ONLY
# Copy to .env and fill in values for local development

# Database connection string (PostgreSQL + PostGIS)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# NASA FIRMS MAP_KEY (free registration at https://firms.modaps.eosdis.nasa.gov/api/)
FIRMS_MAP_KEY=

# OpenAQ API Key (free registration at https://openaq.org/)
OPENAQ_API_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Ingestion lookback window in hours (default 48)
INGEST_LOOKBACK_HOURS=48